{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel API",
        "version": "1.0.0"
    },
    "paths": {
        "/api": {},
        "/api/events/{eventId}/places": {
            "get": {
                "tags": [
                    "API"
                ],
                "summary": "Get all places for an event",
                "description": "Get all places for an event",
                "operationId": "getEventsPlace",
                "parameters": [
                    {
                        "name": "eventId",
                        "in": "path",
                        "description": "ID of event to return places",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "place": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "x": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "y": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "height": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "width": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "is_available": {
                                                        "type": "boolean",
                                                        "example": "true"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/shows": {
            "get": {
                "tags": [
                    "API"
                ],
                "summary": "Get all shows",
                "description": "Get all shows",
                "operationId": "getShows",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "shows": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Show 1"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/shows/{showId}/events": {
            "get": {
                "tags": [
                    "API"
                ],
                "summary": "Get all events for a show",
                "description": "Get all events for a show",
                "operationId": "getShowsEvent",
                "parameters": [
                    {
                        "name": "showId",
                        "in": "path",
                        "description": "ID of show to return events",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "events": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "showId": {
                                                        "type": "integer",
                                                        "example": "1"
                                                    },
                                                    "date": {
                                                        "type": "string",
                                                        "example": "2022-01-01"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/events/{eventId}/reserve": {
            "post": {
                "tags": [
                    "API"
                ],
                "summary": "Reserve places for an event",
                "description": "Reserve places for an event",
                "operationId": "postEventsReserve",
                "parameters": [
                    {
                        "name": "eventId",
                        "in": "path",
                        "description": "ID of event to reserve places",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "places": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer",
                                            "example": "1"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Places reserved successfully"
                                        },
                                        "response": {
                                            "properties": {
                                                "success": {
                                                    "type": "string",
                                                    "example": "success"
                                                },
                                                "reservation_id": {
                                                    "type": "string",
                                                    "example": "66faf1ca12aaa"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "API",
            "description": "API"
        }
    ]
}